# 복사해서 .env.local 로 사용. 실제 키는 커밋하지 않는다.

# mock: UI 개발용 Mock 응답 / live: 실제 LLM·DB 파이프라인
AGENT_MODE=mock

# ── LLM ──
OPENAI_API_KEY=
GENERATOR_MODEL=gpt-4.1-mini
# 상위 추론 모델. 기본값 없음 — 비어 있으면 의미 검증 단계가 차단된다(건너뛰지 않음).
VERIFIER_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_MS=60000

# ── Harness Loop ──
MAX_RETRIES=3
SEMANTIC_SCORE_THRESHOLD=90
REPEATED_ERROR_LIMIT=2

# ── Database (Supabase PostgreSQL) ──
# LLM 생성 SQL 실행 전용 읽기 전용 계정. postgres / service_role 계정은 거부된다.
DATABASE_URL_READONLY=
# 로그·RAG 지식 저장용 앱 계정. SQL 실행에는 사용하지 않는다.
DATABASE_URL_APP=
SEMANTIC_ADMIN_TOKEN=
STATEMENT_TIMEOUT_MS=5000
MAX_RESULT_ROWS=1000
# 쉼표 구분. 비어 있으면 실행 불가(fail-closed).
ALLOWED_SCHEMAS=
