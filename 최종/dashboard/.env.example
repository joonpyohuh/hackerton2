# Copy to .env and supply keys yourself. NEVER commit your real keys.
ADMIN_TOKEN=replace-with-a-long-random-string
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# gpt-5.x / o-series only. Leave empty for gpt-4.x models.
OPENAI_REASONING_EFFORT=low
OPENAI_CONNECT_TIMEOUT_SECONDS=10
OPENAI_READ_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=1
DATABASE_PATH=./runtime/ott_pulse.sqlite3
DATA_JS_PATH=./data.js
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
